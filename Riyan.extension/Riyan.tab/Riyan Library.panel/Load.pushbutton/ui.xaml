<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riyan Family Library"
        Height="760" Width="1220"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        x:Name="RootWindow">

    <Window.Resources>
        <!-- Dynamic Theme Brushes (Default to Dark Theme) -->
        <SolidColorBrush x:Key="WindowBg" Color="#18181B"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#121215"/>
        <SolidColorBrush x:Key="CardBg" Color="#202024"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2E2E33"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#71717A"/>
        <SolidColorBrush x:Key="RiyanMaroon" Color="#802F2D"/>
        <SolidColorBrush x:Key="RiyanMaroonHover" Color="#9C3A38"/>
        <SolidColorBrush x:Key="RiyanMaroonPressed" Color="#632321"/>
        <SolidColorBrush x:Key="HoverBg" Color="#2A2A30"/>
        <SolidColorBrush x:Key="HoverBorder" Color="#3F3F46"/>
        <SolidColorBrush x:Key="SelectedCardBg" Color="#2E1413"/>

        <!-- Modern Floating Acrylic Thumbnail Brushes -->
        <LinearGradientBrush x:Key="ThumbnailBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#25252A" Offset="0.0"/>
            <GradientStop Color="#161619" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ThumbnailBorder" Color="#2E2E36"/>

        <!-- Ultra-Sleek Modern Transparent ScrollBar Style (Zero OS Default Grey) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="false" Opacity="0">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb" Width="6">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#8E8E98" CornerRadius="3" Width="6" Opacity="0.75"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="false" Opacity="0">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="Thumb" Property="Opacity" Value="1.0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="false" Opacity="0">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb" Height="6">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#8E8E98" CornerRadius="3" Height="6" Opacity="0.75"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="false" Opacity="0">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="Thumb" Property="Opacity" Value="1.0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Riyan Signature Primary Maroon Button -->
        <Style x:Key="RiyanPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource RiyanMaroon}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource RiyanMaroonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource RiyanMaroonPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Neutral Button with Visible Hover Highlight -->
        <Style x:Key="RiyanSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource HoverBorder}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Discipline Tab Radio Button with Crisp High-Contrast Hover & Selection -->
        <Style x:Key="DisciplineTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource HoverBorder}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource RiyanMaroon}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource RiyanMaroon}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View Mode Segment Button Style with Crisp Hover & Selection -->
        <Style x:Key="ViewSegmentBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource HoverBorder}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource RiyanMaroon}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource RiyanMaroon}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Styled ComboBox ToggleButton -->
        <ControlTemplate x:Key="RiyanComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="border" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"/>
                    <Path Grid.Column="1" Data="M0,0 L4.5,4.5 L9,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource RiyanMaroon}"/>
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource RiyanMaroon}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Theme-Aware ComboBox Style -->
        <Style x:Key="RiyanComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource RiyanComboBoxToggle}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderColor}" 
                                            BorderThickness="1" CornerRadius="6" Margin="0,3,0,0" Padding="2">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource RiyanMaroon}"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource RiyanMaroonPressed}"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource RiyanComboBox}"/>
    </Window.Resources>

    <Border x:Name="MainOuterBorder" Background="{DynamicResource WindowBg}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>  <!-- Title bar -->
                <RowDefinition Height="46"/>  <!-- Discipline Sub-bar -->
                <RowDefinition Height="*"/>   <!-- Main Area -->
                <RowDefinition Height="56"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" x:Name="TitleBar">
                <Grid Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RIYAN" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" x:Name="TxtTitleRiyan"/>
                        <TextBlock Text=" FAMILY LIBRARY" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" x:Name="TxtTitleLibrary"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Theme Switcher Toggle -->
                        <Button x:Name="BtnToggleTheme" Content="☀️ Light" Margin="0,0,8,0" Padding="8,4" Height="26"
                                Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" 
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HoverBorder}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Admin Sync / Settings -->
                        <Button x:Name="BtnAdminSync" Content="⚙ Sync / Settings" Style="{StaticResource RiyanSecondaryBtn}" Height="28" MinWidth="110" FontSize="11" Margin="0,0,8,0"/>
                        <!-- Maximize / Restore Window Button -->
                        <Button x:Name="BtnMaximize" Content="🗖" Width="30" Height="28" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="13" BorderThickness="0" Cursor="Hand" ToolTip="Maximize / Restore" Margin="0,0,4,0"/>
                        <!-- Close Window Button -->
                        <Button x:Name="BtnClose" Content="✕" Width="30" Height="28" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Discipline Toolbar -->
            <Border Grid.Row="1" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,0" x:Name="DisciplineBar">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabAll" Content="🌐 All Disciplines" Style="{StaticResource DisciplineTab}" IsChecked="True"/>
                    <RadioButton x:Name="TabArc" Content="🏢 Architectural" Style="{StaticResource DisciplineTab}"/>
                    <RadioButton x:Name="TabStr" Content="🏗 Structural" Style="{StaticResource DisciplineTab}"/>
                    <RadioButton x:Name="TabPlumb" Content="🚰 Plumbing" Style="{StaticResource DisciplineTab}"/>
                    <RadioButton x:Name="TabElec" Content="⚡ Electrical" Style="{StaticResource DisciplineTab}"/>
                    <RadioButton x:Name="TabFire" Content="🔥 Fire Protection" Style="{StaticResource DisciplineTab}"/>
                    <RadioButton x:Name="TabAcmv" Content="❄ ACMV" Style="{StaticResource DisciplineTab}"/>
                </StackPanel>
            </Border>

            <!-- 3. Main Split View: Left (Categories), Center (Cards), Right (Detail Inspector) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" MinWidth="170"/> <!-- Level-Based Categories Sidebar -->
                    <ColumnDefinition Width="*"/>                  <!-- Family Cards Grid -->
                    <ColumnDefinition Width="Auto"/>               <!-- Interactive GridSplitter -->
                    <ColumnDefinition Width="320" MinWidth="260" MaxWidth="440"/> <!-- Right Detail Inspector -->
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar: Level-Based Categories List -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0" Padding="12" x:Name="SidebarBorder">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CATEGORIES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RiyanMaroon}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ListBox Grid.Row="1" x:Name="LstCategories" Background="Transparent" BorderThickness="0" 
                                 Foreground="{DynamicResource TextPrimary}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource RiyanMaroon}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter TargetName="border" Property="TextElement.Foreground" Value="#FFFFFF"/>
                                                        <Setter TargetName="border" Property="TextElement.FontWeight" Value="Bold"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Center Area: Search Bar + Family Cards Grid -->
                <Grid Grid.Column="1" Background="{DynamicResource WindowBg}" x:Name="CenterGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Search Bar & Counter -->
                    <Border Grid.Row="0" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,6" x:Name="SearchBarBorder">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Height="32" x:Name="SearchInputBorder">
                                <Grid Margin="10,0">
                                    <TextBlock x:Name="TxtSearchPlaceholder" Text="🔍 Search content names, types, options..." Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" VerticalAlignment="Center" FontSize="12"/>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="1" x:Name="TxtResultsCount" Text="0 Families" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,16,0"/>

                            <!-- View Mode Segmented Buttons (No white popup dropdown) -->
                            <Border Grid.Column="2" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderColor}" 
                                    BorderThickness="1" CornerRadius="6" Padding="2" Height="30" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BtnViewGrid" Content="▦ Grid" ToolTip="Grid View" GroupName="ViewModeGroup" Tag="Grid" IsChecked="True" Style="{DynamicResource ViewSegmentBtn}"/>
                                    <RadioButton x:Name="BtnViewList" Content="☰ List" ToolTip="List View" GroupName="ViewModeGroup" Tag="List" Style="{DynamicResource ViewSegmentBtn}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Cards Scroll Area -->
                    <ScrollViewer Grid.Row="1" x:Name="CardsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8,10,8">
                        <ListBox x:Name="LstFamilies" SelectionMode="Extended" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="4,5,4,5"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="cardBorder" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" 
                                                        BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                            <TranslateTransform X="0" Y="0"/>
                                                        </TransformGroup>
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.06"/>
                                                    </Border.Effect>
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource RiyanMaroon}"/>
                                                        <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        <Setter Property="Panel.ZIndex" Value="10"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource RiyanMaroon}"/>
                                                        <Setter TargetName="cardBorder" Property="BorderThickness" Value="1.5"/>
                                                        <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource SelectedCardBg}"/>
                                                        <Setter Property="Panel.ZIndex" Value="50"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                     To="1.035" Duration="0:0:0.18" DecelerationRatio="0.8"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                     To="1.035" Duration="0:0:0.18" DecelerationRatio="0.8"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                     To="-3.5" Duration="0:0:0.18" DecelerationRatio="0.8"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                     To="0.28" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                     To="14" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                                                     To="4" Duration="0:0:0.18"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                     To="1.0" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                     To="1.0" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                     To="0" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                     To="0.06" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                     To="4" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardBorder"
                                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                                                     To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>
                </Grid>

                <!-- Interactive Drag Splitter between Cards and Inspector -->
                <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE"/>

                <!-- Right Sidebar: Family Inspector & Options -->
                <Border Grid.Column="3" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0" Padding="0" x:Name="InspectorBorder" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                        <StackPanel x:Name="PanelDetail" Visibility="Collapsed" Margin="16,14,10,14">
                            <!-- Large High-Res Preview Image -->
                            <Border Background="{DynamicResource ThumbnailBg}" CornerRadius="8" BorderBrush="{DynamicResource ThumbnailBorder}" BorderThickness="1" Height="185" Margin="0,0,0,12" ClipToBounds="True" x:Name="DetailImgBorder">
                                <Image x:Name="ImgDetailPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"/>
                            </Border>

                            <!-- Family Titles -->
                            <TextBlock x:Name="TxtDetailTitle" Text="Family Base Title" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtDetailCode" Text="RYN_CODE_Technical_Name" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Discipline & Level Category Chips -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="{DynamicResource RiyanMaroon}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtDetailDiscipline" Text="ARCHITECTURAL" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <Border Background="{DynamicResource CardBg}" CornerRadius="4" Padding="8,3" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" x:Name="CategoryBadgeBorder">
                                    <TextBlock x:Name="TxtDetailCategory" Text="Door-Sliding" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                            </StackPanel>

                            <!-- Graphic Capability Badges (Icons) -->
                            <Border Background="{DynamicResource WindowBg}" CornerRadius="6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="10" Margin="0,0,0,14" x:Name="BadgesContainerBorder">
                                <StackPanel>
                                    <TextBlock Text="CAPABILITIES &amp; OPTIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource RiyanMaroon}" Margin="0,0,0,8"/>
                                    <WrapPanel x:Name="PanelBadges" Orientation="Horizontal"/>
                                </StackPanel>
                            </Border>

                            <!-- Available Types Dropdown -->
                            <TextBlock Text="FAMILY TYPES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbTypes" Style="{StaticResource RiyanComboBox}" Height="32" Margin="0,0,0,14"/>

                            <!-- Specifications Summary -->
                            <TextBlock Text="SPECIFICATIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource WindowBg}" CornerRadius="6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="10" Margin="0,0,0,16" x:Name="ParamsContainerBorder">
                                <StackPanel x:Name="PanelParams">
                                    <!-- Dynamic parameters rendered here -->
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <Button x:Name="BtnLoadFamily" Content="⬇ Load into Project" Style="{StaticResource RiyanPrimaryBtn}" Height="36" Margin="0,0,0,8"/>
                            <Button x:Name="BtnLoadTypeOnly" Content="Load Selected Type Only" Style="{StaticResource RiyanSecondaryBtn}" Height="32" Margin="0,0,0,12"/>

                            <!-- Admin Edit in Revit 2025 Button -->
                            <Button x:Name="BtnEdit2025" Content="🛠 Edit Master in Revit 2025" Style="{StaticResource RiyanSecondaryBtn}" 
                                    Height="32" Margin="0,0,0,4"
                                    ToolTip="Opens this family directly in Autodesk Revit 2025 to preserve company-wide backward compatibility."/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 4. Footer Bar -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="16,0" x:Name="FooterBorder">
                <Grid VerticalAlignment="Center">
                    <!-- Status Indicator (Hidden as requested) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource RiyanMaroon}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnFooterLoad" Content="Load Selected" Style="{StaticResource RiyanPrimaryBtn}" Margin="0,0,10,0"/>
                        <Button x:Name="BtnFooterClose" Content="Close" Style="{StaticResource RiyanSecondaryBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Window Drag Resizers (Right Edge, Bottom Edge, Corner) -->
            <Thumb x:Name="ResizeRightThumb" Grid.Row="0" Grid.RowSpan="4" Width="7" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb x:Name="ResizeBottomThumb" Grid.Row="3" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Cursor="SizeNS">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb x:Name="ResizeGripThumb" Grid.Row="3" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Margin="0,0,2,2">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <Path Data="M 14,0 L 14,14 L 0,14 Z M 10,4 L 10,14 L 0,14 Z M 6,8 L 6,14 L 0,14 Z" Fill="{DynamicResource TextMuted}" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Opacity="0.5"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
