<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riyan Family Material Auditor"
        Height="720" Width="920"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        FontFamily="Segoe UI"
        x:Name="RootWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#121316"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#1A1C20"/>
        <SolidColorBrush x:Key="CardBg" Color="#22252A"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2E333D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="RiyanMaroon" Color="#802F2D"/>
        <SolidColorBrush x:Key="RiyanMaroonHover" Color="#9B3836"/>
        <SolidColorBrush x:Key="RiyanMaroonPressed" Color="#632321"/>
        <SolidColorBrush x:Key="HoverBg" Color="#2A2D35"/>
        <SolidColorBrush x:Key="HoverBorder" Color="#474E5D"/>
        <SolidColorBrush x:Key="RiyanRose" Color="#C05652"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>

        <!-- Custom ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border CornerRadius="4" Background="{DynamicResource BorderColor}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>   <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Stats Bar -->
                <RowDefinition Height="*"/>    <!-- Data View & Tabs -->
                <RowDefinition Height="Auto"/> <!-- Live Progress Panel -->
                <RowDefinition Height="65"/>   <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Title Bar -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource SurfaceBg}" CornerRadius="11,11,0,0" 
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource RiyanMaroon}" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="13" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Material Auditor" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <Border Background="#20802F2D" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="RYN_MAT_ Standard" Foreground="{DynamicResource RiyanRose}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Theme Toggle Button -->
                        <Button x:Name="BtnTheme" Content="☀️ Light" Margin="0,0,10,0" Padding="8,4"
                                Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" 
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HoverBorder}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Maximize / Restore Window Button -->
                        <Button x:Name="BtnMaximize" Content="🗖" Width="28" Height="28" Background="Transparent" 
                                Foreground="{DynamicResource TextSecondary}" BorderThickness="0" FontSize="13" Cursor="Hand" ToolTip="Maximize / Restore" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnClose" Content="✕" Width="28" Height="28" Background="Transparent" 
                                Foreground="{DynamicResource TextSecondary}" BorderThickness="0" FontSize="14" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource RiyanMaroon}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource RiyanMaroonPressed}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Summary Stats Bar -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBg}" Padding="18,12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stat 1: Total Families -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12,8" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TOTAL FAMILIES" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtTotalCount" Text="0" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat 2: Compliant -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12,8" Margin="6,0,6,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="RYN_MAT_ COMPLIANT" Foreground="{DynamicResource SuccessGreen}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtCompliantCount" Text="0" Foreground="{DynamicResource SuccessGreen}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat 3: Inconsistent -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12,8" Margin="6,0,6,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="INCONSISTENT MATERIALS" Foreground="{DynamicResource WarningAmber}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtInconsistentCount" Text="0" Foreground="{DynamicResource WarningAmber}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat 4: Missing Parameters -->
                    <Border Grid.Column="3" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12,8" Margin="6,0,0,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MISSING PARAMETERS" Foreground="{DynamicResource RiyanRose}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtMissingParamsCount" Text="0" Foreground="{DynamicResource RiyanRose}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Main Data Tabs -->
            <Grid Grid.Row="2" Margin="18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter / Tab Bar & Search -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="TabInconsistent" Content="Inconsistent Materials" IsChecked="True" 
                                     Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                        <RadioButton x:Name="TabMissing" Content="Missing Parameters" 
                                     Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                        <RadioButton x:Name="TabCompliant" Content="Fully Compliant" 
                                     Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Search Input -->
                    <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceBg}" 
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" 
                            Width="250" Height="30" Padding="8,2" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="TxtSearchPlaceholder" Text="🔍 Search families..." 
                                       Foreground="{DynamicResource TextMuted}" FontSize="11" 
                                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                            <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="{DynamicResource TextPrimary}" 
                                     BorderThickness="0" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Virtualized List View for Lightning-Fast Resizing and Zero Freezes -->
                <Border Grid.Row="1" Background="{DynamicResource CardBg}" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ClipToBounds="True">
                    <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>

            <!-- 4. Real-time In-built Process Log Terminal & Splitter (Dilu BIM Signature Console) -->
            <Grid Grid.Row="3" Margin="18,0,18,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Log Resize Splitter Bar -->
                <Border x:Name="SplitLogs" Grid.Row="0" Height="10" Background="Transparent" Cursor="SizeNS" Margin="0,2,0,2" VerticalAlignment="Center" ToolTip="Drag up/down to resize log terminal (Double-click to expand/collapse)">
                    <Border x:Name="HandleLogs" Height="4" Width="60" CornerRadius="2" Background="{DynamicResource BorderColor}" HorizontalAlignment="Center"/>
                </Border>

                <!-- Real-time Process Log Terminal -->
                <Border x:Name="CardLogs" Grid.Row="1" Height="85" MinHeight="40" MaxHeight="350" Background="#0B0D11" CornerRadius="6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <TextBox x:Name="TxtLog" Background="#0B0D11" Foreground="#22C55E" FontFamily="Consolas" FontSize="11"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" BorderThickness="0" Padding="8,6"/>
                </Border>

                <!-- Live Progress Status Bar -->
                <Grid x:Name="PanelProgress" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtProgressStatus" Text="Standardizing materials to RYN_MAT_..." 
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtProgressPct" Text="0%" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource RiyanRose}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressBarStandardize" Grid.Row="1" Height="5" Minimum="0" Maximum="100" Value="0"
                                 Background="{DynamicResource CardBg}" BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2.5" ClipToBounds="True">
                                    <Border x:Name="PART_Indicator" Background="{DynamicResource RiyanMaroon}" CornerRadius="2.5" HorizontalAlignment="Left"/>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Grid>
            </Grid>

            <!-- 5. Footer Actions -->
            <Border Grid.Row="4" Background="{DynamicResource SurfaceBg}" CornerRadius="0,0,11,11" 
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="18,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDocName" Text="Document: Active Project" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Export Button -->
                        <Button x:Name="BtnExport" Content="📄 Export Report" Margin="0,0,10,0" Padding="14,0" Height="36"
                                Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" 
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HoverBorder}"/>
                                            <Setter TargetName="bd" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Standardize Button -->
                        <Button x:Name="BtnStandardize" Content="✨ Apply Standardization (RYN_MAT_)" 
                                Padding="16,0" Height="36" Background="{DynamicResource RiyanMaroon}" Foreground="White" 
                                BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource RiyanMaroonHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource RiyanMaroonPressed}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. Window Drag Resizers (Right Edge, Bottom Edge, Corner) -->
            <Thumb x:Name="ResizeRightThumb" Grid.Row="0" Grid.RowSpan="5" Width="7" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb x:Name="ResizeBottomThumb" Grid.Row="4" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Cursor="SizeNS">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb x:Name="ResizeGripThumb" Grid.Row="4" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Margin="0,0,2,2">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <Path Data="M 14,0 L 14,14 L 0,14 Z M 10,4 L 10,14 L 0,14 Z M 6,8 L 6,14 L 0,14 Z" Fill="{DynamicResource TextMuted}" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Opacity="0.5"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
