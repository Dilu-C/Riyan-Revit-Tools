<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Export Manager" Height="700" Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="WindowBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TitleBarBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TextMain" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextDim" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#802F2D"/>
        
        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#802F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9E3A38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#802F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <TextBlock Text="&#x2715;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A13634"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="0">
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBg}" CornerRadius="10,10,0,0" MouseDown="TitleBar_MouseDown">
                <Grid Grid.IsSharedSizeScope="True">
                    <TextBlock Text="Riyan Batch Export Manager" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button x:Name="BtnTheme" Content="&#x2600;" FontFamily="Segoe UI Symbol" Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="BtnTheme_Click" ToolTip="Switch Theme"/>
                        <Button x:Name="BtnMinimize" Content="-" Width="30" Height="30" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{StaticResource TextMain}" Click="MinimizeBtn_Click"/>
                        <Button x:Name="BtnClose" Style="{StaticResource CloseBtnStyle}" Width="40" Height="30" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Tables & Options -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Button x:Name="BtnAddFolder" Style="{StaticResource PrimaryBtn}" Content="+ Add Folder" Width="105" Height="32" Margin="0,0,6,0" Click="BtnAddFolder_Click"/>
                        <Button x:Name="BtnAddFile" Style="{StaticResource SecondaryBtn}" Content="+ Add Revit Files" Width="115" Height="32" Click="BtnAddFile_Click"/>
                        <Button x:Name="BtnClearAll" Style="{StaticResource SecondaryBtn}" Content="Clear All" Width="65" Height="32" Margin="6,0,12,0" Click="BtnClearAll_Click"/>
                        
                        <Border Width="1" Height="22" Background="{StaticResource BorderColor}" Margin="0,0,12,0"/>

                        <TextBlock Text="Sheet Set for All:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource TextDim}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbMasterSet" Width="130" Height="28" IsEditable="True" Text="PRINT" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnApplySetToAll" Style="{StaticResource SecondaryBtn}" Content="Apply to All" Width="80" Height="28" Margin="0,0,12,0" Click="BtnApplySetToAll_Click"/>

                        <Border Width="1" Height="22" Background="{StaticResource BorderColor}" Margin="0,0,12,0"/>

                        <TextBlock Text="Naming Profile:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource TextDim}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbGlobalProfile" Width="120" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HCol0" Width="380" MinWidth="260" SharedSizeGroup="Col0"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition x:Name="HCol1" Width="180" MinWidth="130" SharedSizeGroup="Col1"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition x:Name="HCol2" Width="200" MinWidth="140" SharedSizeGroup="Col2"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition x:Name="HCol3" Width="*" MinWidth="140" SharedSizeGroup="Col3"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,1" Padding="5,0,0,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                <CheckBox x:Name="ChkSelectAllFiles" IsChecked="True" IsThreeState="True" VerticalAlignment="Center" Margin="0,0,8,0" Click="ChkSelectAllFiles_Click" ToolTip="Select / Deselect All Files"/>
                                <TextBlock Text="Revit File" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                        
                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,1" Padding="5,0,0,5"><TextBlock Text="Sheet Set" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/></Border>
                        <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                        
                        <Border Grid.Column="4" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,1" Padding="5,0,0,5"><TextBlock Text="Output Location" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/></Border>
                        <GridSplitter Grid.Column="5" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                        
                        <Border Grid.Column="6" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="5,0,0,5"><TextBlock Text="Status" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/></Border>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FileStack" Orientation="Vertical">
                            <!-- Rows dynamically injected by script.py -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Options -->
                    <StackPanel Grid.Row="3" Margin="0,15,0,0" Orientation="Horizontal">
                        <TextBlock Text="Export Mode:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,10,0"/>
                        <RadioButton x:Name="RbCheckPrint" Content="Check Print (Combined PDF Only)" Foreground="{StaticResource TextMain}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <RadioButton x:Name="RbFinalExport" Content="Final Export (Combined PDF + Separate CAD/PDF)" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Right Column: Sheet Preview & Details Sidebar -->
                <Border Grid.Column="2" Background="{StaticResource TitleBarBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <TextBlock Grid.Row="0" Text="Sheet Preview &amp; Details" Foreground="{StaticResource TextMain}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                        <!-- Preview Container Box -->
                        <Border Grid.Row="1" Background="#141414" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <!-- Rendered Preview Image -->
                                <Image x:Name="ImgPreview" Stretch="Uniform" Visibility="Collapsed" Cursor="Hand" ToolTip="Click to view full size modal"/>

                                <!-- Placeholder / Action Center -->
                                <StackPanel x:Name="GridPreviewPrompt" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtPreviewHint" Text="Select a sheet from list" Foreground="{StaticResource TextDim}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnDoPreview" Style="{StaticResource PrimaryBtn}" Content="Preview Sheet" Width="120" Height="30" Visibility="Collapsed" Click="BtnPreview_Click"/>
                                </StackPanel>

                                <!-- Loading Indicator -->
                                <StackPanel x:Name="GridPreviewLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="Rendering Sheet..." Foreground="{StaticResource TextDim}" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sheet Details -->
                        <Border Grid.Row="2" Background="#242426" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Selected Sheet Info" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                    
                                    <TextBlock Text="Sheet Number" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                    <TextBlock x:Name="TxtDetailNumber" Text="-" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    
                                    <TextBlock Text="Sheet Name" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                    <TextBlock x:Name="TxtDetailName" Text="-" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    
                                    <TextBlock Text="Sheet Collection" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                    <TextBlock x:Name="TxtDetailCollection" Text="-" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    
                                    <TextBlock Text="Export Filename" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                    <TextBlock x:Name="TxtDetailExportName" Text="-" Foreground="{StaticResource TextMain}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    
                                    <TextBlock Text="Revit File" Foreground="{StaticResource TextDim}" FontSize="10"/>
                                    <TextBlock x:Name="TxtDetailModel" Text="-" Foreground="{StaticResource TextDim}" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource TitleBarBg}" CornerRadius="0,0,10,10" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                <Grid Margin="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtFileCount" Text="0 Files Loaded" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <ProgressBar x:Name="ExportProgressBar" Width="260" Height="8" Foreground="{StaticResource PrimaryColor}" Background="#3F3F46" BorderThickness="0" Maximum="100" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPercent" Text="Ready" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Style="{StaticResource SecondaryBtn}" Content="Cancel" Width="90" Height="32" Margin="0,0,10,0" Click="CloseBtn_Click"/>
                        <Button x:Name="BtnExport" Style="{StaticResource PrimaryBtn}" Content="Run Batch Export" Width="140" Height="32" Click="BtnExport_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>








