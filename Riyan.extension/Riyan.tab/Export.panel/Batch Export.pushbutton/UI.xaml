<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Export Manager" Height="700" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="WindowBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TitleBarBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TextMain" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextDim" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#802F2D"/>
        
        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#802F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9E3A38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#802F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <TextBlock Text="&#x2715;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A13634"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="0">
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBg}" CornerRadius="10,10,0,0" MouseDown="TitleBar_MouseDown">
                <Grid Grid.IsSharedSizeScope="True">
                    <TextBlock Text="Riyan Batch Export Manager" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button x:Name="BtnTheme" Content="&#x2600;" FontFamily="Segoe UI Symbol" Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="BtnTheme_Click" ToolTip="Switch Theme"/>
                        <Button x:Name="BtnMinimize" Content="-" Width="30" Height="30" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{StaticResource TextMain}" Click="MinimizeBtn_Click"/>
                        <Button x:Name="BtnClose" Style="{StaticResource CloseBtnStyle}" Width="40" Height="30" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="BtnAddFile" Style="{StaticResource PrimaryBtn}" Content="+ Add Revit Files" Width="130" Height="32" Click="BtnAddFile_Click"/>
                    <Button x:Name="BtnClearAll" Style="{StaticResource SecondaryBtn}" Content="Clear All" Width="80" Height="32" Margin="10,0,0,0" Click="BtnClearAll_Click"/>
                    <Button x:Name="BtnPreview" Style="{StaticResource SecondaryBtn}" Content="Preview Sheet" Width="100" Height="32" Margin="10,0,0,0" Click="BtnPreview_Click"/>
                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,8" Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" SharedSizeGroup="Col0"/>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="150" SharedSizeGroup="Col1"/>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="150" SharedSizeGroup="Col2"/>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="150" SharedSizeGroup="Col3"/>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*" SharedSizeGroup="Col4"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,1" Padding="5,0,0,5"><TextBlock Text="Revit File" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/></Border>
                    <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                    
                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,1" Padding="5,0,0,5"><TextBlock Text="Sheet Set" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/></Border>
                    <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                    
                    <Border Grid.Column="4" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,1" Padding="5,0,0,5"><TextBlock Text="Naming Profile" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/></Border>
                    <GridSplitter Grid.Column="5" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                    
                    <Border Grid.Column="6" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,1" Padding="5,0,0,5"><TextBlock Text="Output Location" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/></Border>
                    <GridSplitter Grid.Column="7" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                    
                    <Border Grid.Column="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,1" Padding="5,0,0,5"><TextBlock Text="Status" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/></Border>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FileStack" Orientation="Vertical">
                        <!-- Rows dynamically injected by script.py -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Options -->
                <StackPanel Grid.Row="3" Margin="0,15,0,0" Orientation="Horizontal">
                    <TextBlock Text="Export Mode:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,10,0"/>
                    <RadioButton x:Name="RbCheckPrint" Content="Check Print (Combined PDF Only)" Foreground="{StaticResource TextMain}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <RadioButton x:Name="RbFinalExport" Content="Final Export (Combined PDF + Separate CAD/PDF)" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource TitleBarBg}" CornerRadius="0,0,10,10" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                <Grid Margin="15,0">
                    <ProgressBar x:Name="ExportProgressBar" Width="300" Height="8" HorizontalAlignment="Left" Foreground="{StaticResource PrimaryColor}" Background="#3F3F46" BorderThickness="0" Maximum="100"/>
                    <TextBlock x:Name="TxtPercent" Text="Ready" HorizontalAlignment="Left" Margin="315,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Style="{StaticResource SecondaryBtn}" Content="Cancel" Width="90" Height="32" Margin="0,0,10,0" Click="CloseBtn_Click"/>
                        <Button x:Name="BtnExport" Style="{StaticResource PrimaryBtn}" Content="Run Batch Export" Width="140" Height="32" Click="BtnExport_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>








