<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Already Exists" Height="220" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="⚠️" FontSize="32" Margin="0,0,15,0" VerticalAlignment="Top" Foreground="#FFCC00"/>
            <TextBlock Name="TxtMessage" Text="A file named 'test.pdf' already exists in the destination.&#x0a;&#x0a;What would you like to do?" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Top" Width="340"/>
        </StackPanel>
        
        <CheckBox Name="ChkApplyToAll" Grid.Row="1" Content="Do this for all remaining conflicts" FontSize="13" Margin="47,15,0,15" VerticalAlignment="Center" Foreground="#333333"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnReplace" Content="Replace" Width="80" Height="28" Margin="5,0" Click="BtnReplace_Click" Background="#0078D7" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Name="BtnRename" Content="Rename" Width="80" Height="28" Margin="5,0" Click="BtnRename_Click" Background="White" BorderBrush="#CCCCCC" Cursor="Hand"/>
            <Button Name="BtnSkip" Content="Skip" Width="80" Height="28" Margin="5,0,0,0" Click="BtnSkip_Click" Background="White" BorderBrush="#CCCCCC" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
