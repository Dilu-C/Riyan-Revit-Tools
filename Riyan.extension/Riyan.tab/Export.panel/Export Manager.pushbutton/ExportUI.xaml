<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riyan Export Manager" Height="740" Width="1340"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Dynamic Theme Brushes -->
        <!-- Dynamic Theme Brushes -->
        <SolidColorBrush x:Key="WindowBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TitleBarBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ControlBg" Color="#333337"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
        <SolidColorBrush x:Key="FooterBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#71717A"/>
        <SolidColorBrush x:Key="ThemeBtnHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="ThemeBtnBorderHover" Color="#4B5563"/>
        <SolidColorBrush x:Key="ThemeBtnHoverFg" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BtnDisabledBg" Color="#252528"/>
        <SolidColorBrush x:Key="BtnDisabledBorder" Color="#333337"/>
        <SolidColorBrush x:Key="BtnDisabledFg" Color="#71717A"/>
        <SolidColorBrush x:Key="BtnHoverBg" Color="#3E3E42"/>
        <SolidColorBrush x:Key="BtnHoverBorder" Color="#4B5563"/>
        <SolidColorBrush x:Key="BtnHoverFg" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="TabBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="TabBorder" Color="#00000000"/>
        <SolidColorBrush x:Key="TabItemFg" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="TabItemSelectedBg" Color="#00000000"/>
        <SolidColorBrush x:Key="TabItemSelectedBorder" Color="#802F2D"/>
        <SolidColorBrush x:Key="TabItemSelectedFg" Color="#F5F5F5"/>

        <SolidColorBrush x:Key="GridHeaderBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="GridHeaderFg" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="GridHeaderBorder" Color="#3F3F46"/>
        <SolidColorBrush x:Key="GridBorder" Color="#3F3F46"/>
        <SolidColorBrush x:Key="GridRowBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="GridRowAltBg" Color="#28282B"/>
        <SolidColorBrush x:Key="GridRowFg" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="GridRowHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="GridRowSelected" Color="#2E1413"/>

        <SolidColorBrush x:Key="CustomFileNameHeaderBg" Color="#2A2218"/>
        <SolidColorBrush x:Key="CustomFileNameHeaderBorder" Color="#C8922A"/>
        <SolidColorBrush x:Key="CustomFileNameHeaderFg" Color="#C8922A"/>
        <SolidColorBrush x:Key="CustomFileNameCellFg" Color="#C8922A"/>

        <SolidColorBrush x:Key="SidebarBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SidebarBorder" Color="#3F3F46"/>

        <!-- Primary (accent) button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"       Value="#802F2D"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Height"           Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9E3A38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#661F1D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary (dark) button -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"       Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground"       Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Height"           Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHoverBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BtnHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnDisabledBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnDisabledBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BtnDisabledBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeBtnBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TabItemSelectedBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource TabItemSelectedBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeBtnBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TabItemSelectedBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark CheckBox -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Dark ContextMenu -->
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="4,4"/>
        </Style>
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- Dark RadioButton -->
        <Style x:Key="DarkRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <!-- Dark ComboBox with rounded toggle -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="border" Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"/>
                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource TextMuted}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeBtnBorderHover}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background"         Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground"         Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush"        Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Height"             Value="28"/>
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False"
                                              Margin="8,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6">
                                        <ScrollViewer>
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background"   Value="{DynamicResource ControlBg}"/>
                    <Setter Property="Foreground"   Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="Padding"      Value="8,4"/>
                    <Setter Property="FontSize"     Value="11"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TabItemSelectedBorder}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TabItemSelectedBorder}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>

        <!-- TabControl and TabItem styling -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource TabBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="14,0,0,0" Panel.ZIndex="1"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,6,6,6">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TabItemFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{DynamicResource TabItemSelectedBg}" BorderBrush="{DynamicResource TabItemSelectedBorder}" BorderThickness="0,0,0,2" Margin="0,0,12,0" Padding="0,0,0,4">
                            <ContentPresenter x:Name="contentPresenter" ContentSource="Header" Focusable="False" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TabItemSelectedBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TabItemSelectedFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridRowBg}"/>
            <Setter Property="RowBackground" Value="{DynamicResource GridRowBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridRowAltBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridRowFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridHeaderFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridHeaderBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GridRowHover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="{DynamicResource TabItemSelectedBorder}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="{DynamicResource TabItemSelectedBorder}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource GridRowFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource GridRowBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridHeaderBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0" Margin="0" SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" 
                                                         SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" 
                                                           SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" 
                                                           Visibility="{TemplateBinding DetailsVisibility}"/>
                                <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" 
                                                    Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                            </SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource GridRowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource GridRowSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainOuterBorder" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource WindowBg}" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/> <!-- Tab Headers Area -->
                <RowDefinition Height="*"/>    <!-- Tab Content -->
                <RowDefinition Height="Auto"/> <!-- Wizard Navigation Footer -->
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="TitleBar_MouseDown" CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image x:Name="TitleLogo" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Riyan Export Manager" Foreground="#802F2D" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="btnThemeToggle" Content="☀️ Light" Width="76" Height="26" Margin="0,0,10,0"
                            Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="ThemeToggle_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="tbBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5" Padding="8,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="tbBorder" Property="Background" Value="{DynamicResource ThemeBtnHover}"/>
                                        <Setter TargetName="tbBorder" Property="BorderBrush" Value="{DynamicResource ThemeBtnBorderHover}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeBtnHoverFg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="MinimizeBtn" Content="—" Width="40" Height="28" BorderThickness="0" Cursor="Hand" Background="Transparent" Foreground="#888888" Click="MinimizeBtn_Click" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#252525"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="MaximizeBtn" Content="☐" Width="40" Height="28" BorderThickness="0" Cursor="Hand" Background="Transparent" Foreground="#888888" Click="MaximizeBtn_Click" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#252525"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="CloseBtn" Content="✕" Width="40" Height="28" BorderThickness="0" Cursor="Hand" Background="Transparent" Foreground="#888888" Click="CloseBtn_Click" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,11,0,0" BorderBrush="#A03B38">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#802F2D"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>

            <!-- PROFILE MANAGER (Floats over Tab Headers) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,24,0" Panel.ZIndex="10">
                <TextBlock Text="👤 Profile" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbProfile" Style="{StaticResource DarkComboBox}" Width="150" Margin="0,0,8,0" SelectionChanged="CmbProfile_SelectionChanged"/>
                <Button x:Name="BtnAddProfile" Content="+" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="0,0,4,0" Click="BtnAddProfile_Click" ToolTip="New Profile"/>
                <Button x:Name="BtnSaveProfile" Content="💾" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="0,0,4,0" Click="BtnSaveProfile_Click" ToolTip="Save/Edit Profile"/>
                <Button x:Name="BtnImportProfile" Content="📂" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="0,0,4,0" Click="BtnImportProfile_Click" ToolTip="Import Profile from XML"/>
                <Button x:Name="BtnDeleteProfile" Content="🗑" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Click="BtnDeleteProfile_Click" ToolTip="Delete Profile"/>
                <Button x:Name="BtnRenameProfile" Content="✏" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="4,0,0,0" Click="BtnRenameProfile_Click" ToolTip="Rename Profile"/>
            </StackPanel>

            <!-- WIZARD WIDGET CONTAINER -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Grid.RowSpan="2" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
                
                <!-- TAB 1: SELECTION -->
                <TabItem Header="Selection">
                    <Grid Margin="24,16,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Row 0: Radios & Search -->
                            <RowDefinition Height="*"/>    <!-- Row 1: Sheet DataGrid -->
                            <RowDefinition Height="Auto"/> <!-- Row 2: Bottom Selection Info -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Radios & Search -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Radios -->
                                <ColumnDefinition Width="Auto"/> <!-- View/Sheet Set text -->
                                <ColumnDefinition Width="Auto"/> <!-- Filter Combo -->
                                <ColumnDefinition Width="Auto"/> <!-- Set Action Buttons + Favorite -->
                                <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                <ColumnDefinition Width="220"/>  <!-- Search -->
                            </Grid.ColumnDefinitions>

                            <!-- Sheets/Views Radio Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <RadioButton x:Name="RbSheets" Content="Sheets" Style="{StaticResource DarkRadio}" IsChecked="True" Checked="RbMode_Checked"/>
                                <RadioButton x:Name="RbViews" Content="Views" Style="{StaticResource DarkRadio}" IsEnabled="True" Checked="RbMode_Checked"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="View/Sheet Set" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0" FontWeight="SemiBold"/>

                            <ComboBox x:Name="CmbFilterSets" Grid.Column="2" Style="{StaticResource DarkComboBox}" Width="150" Margin="0,0,8,0" SelectionChanged="CmbFilterSets_SelectionChanged"/>

                            <!-- Set Action Buttons matching Revit Print Dialog -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Save current set -->
                                <Button x:Name="BtnSaveSet" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="0,0,3,0" Click="BtnSaveSet_Click" ToolTip="Save current set">
                                    <TextBlock Text="💾" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <!-- Duplicate set -->
                                <Button x:Name="BtnDuplicateSet" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="0,0,3,0" Click="BtnDuplicateSet_Click" ToolTip="Duplicate set">
                                    <Grid Width="15" Height="15">
                                        <Border Width="9" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0" BorderBrush="#888888" BorderThickness="1" Background="#3A3A3A" CornerRadius="1"/>
                                        <Border Width="9" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" BorderBrush="#DDDDDD" BorderThickness="1" Background="#1E1E1E" CornerRadius="1"/>
                                    </Grid>
                                </Button>
                                <!-- Create new set -->
                                <Button x:Name="BtnNewSet" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="0,0,3,0" Click="BtnNewSet_Click" ToolTip="Create new empty set">
                                    <Grid Width="15" Height="15">
                                        <Border Width="10" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" BorderBrush="#DDDDDD" BorderThickness="1" Background="#1E1E1E" CornerRadius="1"/>
                                        <TextBlock Text="✦" FontSize="11" Foreground="#FF9800" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-3,0,0"/>
                                    </Grid>
                                </Button>
                                <!-- Rename set -->
                                <Button x:Name="BtnRenameSet" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="0,0,3,0" Click="BtnRenameSet_Click" ToolTip="Rename set">
                                    <Border Width="15" Height="14" Background="#1976D2" CornerRadius="2">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="A" FontSize="9" FontWeight="Bold" Foreground="White" Margin="0,-1,1,0"/>
                                            <Rectangle Width="1.2" Height="9" Fill="White"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <!-- Delete set -->
                                <Button x:Name="BtnDeleteSet" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="0,0,4,0" Click="BtnDeleteSet_Click" ToolTip="Delete set">
                                    <Grid Width="15" Height="15">
                                        <Border Width="10" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" BorderBrush="#DDDDDD" BorderThickness="1" Background="#1E1E1E" CornerRadius="1"/>
                                        <TextBlock Text="✕" FontSize="10" Foreground="#F44336" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-2,0,0"/>
                                    </Grid>
                                </Button>
                                <!-- Favorite star -->
                                <Button x:Name="BtnFavoriteStar" Style="{StaticResource SecondaryBtn}" Width="26" Height="26" Margin="1,0,0,0" Click="BtnFavorite_Click" ToolTip="Favorites">
                                    <TextBlock x:Name="TxtFavoriteStar" Text="☆" Foreground="#C8922A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Button>
                            </StackPanel>

                            <!-- Live Search Box -->
                            <Grid Grid.Column="5">
                                <TextBox x:Name="TxtSearch" Padding="8,6,24,6" TextChanged="TxtSearch_TextChanged"/>
                                <TextBlock IsHitTestVisible="False" Text="Search..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- Row 1: Sheets DataGrid + Preview Sidebar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="310"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sheets DataGrid -->
                            <Border Grid.Column="0" CornerRadius="8" BorderBrush="{DynamicResource GridBorder}" BorderThickness="1" ClipToBounds="True">
                                <DataGrid x:Name="GridSheets" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" BorderThickness="0" CanUserResizeRows="True" CanUserSortColumns="True" Sorting="GridSheets_Sorting" PreviewKeyDown="GridSheets_PreviewKeyDown" MouseDoubleClick="GridSheets_MouseDoubleClick" SelectionChanged="GridSheets_SelectionChanged">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Style="{StaticResource DarkContextMenu}">
                                            <MenuItem Header="👁  Preview Sheet (Double-Click)" Click="MenuPreviewSheet_Click" Style="{StaticResource DarkMenuItem}"/>
                                            <Separator/>
                                            <MenuItem Header="✓  Check Selected (Space)" Click="MenuCheckSelected_Click" Style="{StaticResource DarkMenuItem}"/>
                                        <MenuItem Header="☐  Uncheck Selected" Click="MenuUncheckSelected_Click" Style="{StaticResource DarkMenuItem}"/>
                                        <MenuItem Header="⇄  Invert Selected" Click="MenuInvertSelected_Click" Style="{StaticResource DarkMenuItem}"/>
                                        <Separator/>
                                        <MenuItem Header="Select All Sheets" Click="MenuCheckAll_Click" Style="{StaticResource DarkMenuItem}"/>
                                        <MenuItem Header="Unselect All Sheets" Click="MenuUncheckAll_Click" Style="{StaticResource DarkMenuItem}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="45" CanUserSort="False">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource GridHeaderBorder}"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource GridRowHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <Grid PreviewMouseLeftButtonDown="HeaderCheckBoxCell_MouseDown" Background="#01000000" Cursor="Hand"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="32">
                                                <CheckBox x:Name="CbHeaderSelectAll" Style="{StaticResource DarkCheckBox}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Grid>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="DataGridCell">
                                                            <Border Background="{TemplateBinding Background}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid PreviewMouseLeftButtonDown="SheetCheckBoxCell_MouseDown" Background="#01000000" Cursor="Hand"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkCheckBox}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="150" IsReadOnly="True" FontWeight="Bold" SortMemberPath="SheetNumber" CanUserSort="True">
                                        <DataGridTextColumn.Header>
                                            <Border Tag="SheetNumber" PreviewMouseLeftButtonDown="SortHeader_MouseDown" Background="Transparent" Cursor="Hand"
                                                    Padding="10,8" Margin="-10,-8,-10,-8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock Text="Sheet Number" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GridHeaderFg}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtSort_SheetNumber" Text="▼" FontSize="10" Foreground="{DynamicResource GridHeaderFg}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="SheetNumber" Mode="OneWay"/>
                                        </DataGridTextColumn.Binding>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Width="*" IsReadOnly="True" SortMemberPath="SheetName" CanUserSort="True">
                                        <DataGridTextColumn.Header>
                                            <Border Tag="SheetName" PreviewMouseLeftButtonDown="SortHeader_MouseDown" Background="Transparent" Cursor="Hand"
                                                    Padding="10,8" Margin="-10,-8,-10,-8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock Text="Sheet Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GridHeaderFg}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtSort_SheetName" Text="▼" FontSize="10" Foreground="{DynamicResource GridHeaderFg}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="SheetName" Mode="OneWay"/>
                                        </DataGridTextColumn.Binding>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Width="80" IsReadOnly="True" SortMemberPath="Revision" CanUserSort="True">
                                        <DataGridTextColumn.Header>
                                            <Border Tag="Revision" PreviewMouseLeftButtonDown="SortHeader_MouseDown" Background="Transparent" Cursor="Hand"
                                                    Padding="10,8" Margin="-10,-8,-10,-8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock Text="Revision" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GridHeaderFg}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtSort_Revision" Text="▼" FontSize="10" Foreground="{DynamicResource GridHeaderFg}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="Revision" Mode="OneWay"/>
                                        </DataGridTextColumn.Binding>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Width="80" IsReadOnly="True" SortMemberPath="Size" CanUserSort="True">
                                        <DataGridTextColumn.Header>
                                            <Border Tag="Size" PreviewMouseLeftButtonDown="SortHeader_MouseDown" Background="Transparent" Cursor="Hand"
                                                    Padding="10,8" Margin="-10,-8,-10,-8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock Text="Size" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GridHeaderFg}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtSort_Size" Text="▼" FontSize="10" Foreground="{DynamicResource GridHeaderFg}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="Size" Mode="OneWay"/>
                                        </DataGridTextColumn.Binding>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Custom File Name Column — Accented Header like ProSheets -->
                                    <DataGridTemplateColumn Width="2.5*" SortMemberPath="CustomFileName" CanUserSort="False" IsReadOnly="True">
                                        <DataGridTemplateColumn.Header>
                                            <Button Click="BtnNamingBuilder_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{DynamicResource CustomFileNameHeaderBg}" BorderBrush="{DynamicResource CustomFileNameHeaderBorder}" BorderThickness="0,0,0,2"
                                                                Padding="10,8" Margin="-10,-8,-10,-8" x:Name="border">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="Custom File Name" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource CustomFileNameHeaderFg}" VerticalAlignment="Center"/>
                                                                <TextBlock Text=" ✎" FontSize="12" Foreground="{DynamicResource CustomFileNameHeaderFg}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CustomFileName}" VerticalAlignment="Center" Padding="6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="12.5"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource CustomFileNameCellFg}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CustomFileName}" Value="">
                                                                    <Setter Property="Text" Value="Edit filename..."/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                            <!-- Right Column: Sheet Preview & Details Sidebar -->
                            <Border Grid.Column="2" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="220"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Panel Header -->
                                    <TextBlock Grid.Row="0" Text="Sheet Preview &amp; Details" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                                    <!-- Preview Container Box -->
                                    <Border Grid.Row="1" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                        <Grid>
                                            <!-- Rendered Preview Image -->
                                            <Image x:Name="ImgPreview" Stretch="Uniform" Visibility="Collapsed" Cursor="Hand" ToolTip="Click to view full size modal"/>

                                            <!-- Placeholder / Action Center -->
                                            <StackPanel x:Name="GridPreviewPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                                <TextBlock Text="📐" FontSize="32" Foreground="{DynamicResource CustomFileNameHeaderFg}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBlock x:Name="TxtPreviewHint" Text="Select a sheet from list" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,10" TextAlignment="Center"/>
                                                <Button x:Name="BtnDoPreview" Style="{StaticResource PrimaryBtn}" Content="👁  Preview Sheet" Width="130" Height="30" Visibility="Collapsed" Click="BtnPreview_Click" Cursor="Hand"/>
                                                <TextBlock Text="(or double-click row)" Foreground="{DynamicResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>

                                            <!-- Loading Indicator -->
                                            <StackPanel x:Name="GridPreviewLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="Opening Sheet..." Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Sheet Details -->
                                    <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0" Padding="10">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="Selected Sheet Info" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                                
                                                <TextBlock Text="Sheet Number" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                                <TextBlock x:Name="TxtDetailNumber" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                
                                                <TextBlock Text="Sheet Name" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                                <TextBlock x:Name="TxtDetailName" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                
                                                <TextBlock Text="Sheet Size" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                                <TextBlock x:Name="TxtDetailCollection" Text="-" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                
                                                <TextBlock Text="Export Filename" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                                <TextBlock x:Name="TxtDetailExportName" Text="-" Foreground="{DynamicResource CustomFileNameCellFg}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                
                                                <TextBlock Text="Revit Model" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                                <TextBlock x:Name="TxtDetailModel" Text="-" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Bottom Selection Info -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox x:Name="CbShowActive" Click="CbShowActive_Click" Content="Show only active Sheets/Views" Style="{StaticResource DarkCheckBox}" Margin="0,0,8,0"/>
                                <Button x:Name="BtnBottomFavoriteStar" Click="BtnFavorite_Click" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Favorites" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBottomFavoriteStar" Text="☆" Foreground="{DynamicResource CustomFileNameHeaderFg}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>


                <!-- TAB 2: FORMAT -->
                <TabItem Header="Format">
                    <Grid Margin="24,20,24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                            <!-- LEFT PANEL: Formats -->
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="EXPORT FORMATS" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24" VerticalAlignment="Center">
                                    <CheckBox x:Name="CbPDF" Content="PDF" Style="{StaticResource DarkCheckBox}" Margin="0,0,20,0" IsChecked="True" Click="CbFormat_Click" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="CbDWG" Content="DWG" Style="{StaticResource DarkCheckBox}" Margin="0,0,20,0" IsChecked="True" Click="CbFormat_Click" VerticalAlignment="Center"/>
                                    <Border Width="1" Height="14" Background="{DynamicResource BorderColor}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="CbExcelTransmittal" Content="Drawing List:" Style="{StaticResource DarkCheckBox}" IsChecked="False" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="RbListExcel" GroupName="EmListFormat" Content="Excel (.xlsx)" Foreground="{DynamicResource TextSecondary}" FontSize="11" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="RbListWord" GroupName="EmListFormat" Content="Word (.doc)" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <TextBlock Text="FILE" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <StackPanel>
                                        <RadioButton x:Name="RbSeparateFiles" Content="Create separate files" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" IsChecked="True" Margin="0,0,0,8" Click="RbFileOption_Click"/>
                                        <RadioButton x:Name="RbCombineFiles" Content="Combine multiple views/sheets into a single file" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" Click="RbFileOption_Click"/>
                                        
                                        <StackPanel x:Name="PanelCombineOptions" Margin="24,12,0,0" IsEnabled="False">
                                            <Button x:Name="BtnCombinedNaming" Content="Custom File Name" Style="{StaticResource SecondaryBtn}" Width="150" HorizontalAlignment="Left" Click="BtnCombinedNaming_Click" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="Combined file name preview:" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtCombinedFileName" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8,6" FontSize="11" Margin="0,0,0,8" IsReadOnly="True" Text="Combined_PDF"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT PANEL: Setups -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EXPORT SETUPS" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,12"/>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="PDF Print Setting:" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbPdfSetup" Style="{StaticResource DarkComboBox}" SelectionChanged="CmbPdfSetup_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="DWG Export Setup:" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbDwgSetup" Style="{StaticResource DarkComboBox}" SelectionChanged="CmbDwgSetup_SelectionChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                </TabItem>

                <!-- TAB 3: CREATE -->
                <TabItem Header="Create">
                    <Grid Margin="24,16,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Export Directory -->
                            <RowDefinition Height="*"/>    <!-- Queue Grid -->
                            <RowDefinition Height="Auto"/> <!-- Progress reporting -->
                        </Grid.RowDefinitions>

                        <!-- Export Directory Select -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="EXPORT DIRECTORY" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtExportPath" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                                         Padding="8,6" FontSize="11" Margin="0,0,8,0" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnBrowse" Grid.Column="1" Content="..." Style="{StaticResource SecondaryBtn}" Width="42" Height="28" Click="BtnBrowse_Click"/>
                            </Grid>
                            
                            <!-- Export Rules (Split Options) -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="EXPORT RULES:" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <RadioButton x:Name="RbSaveSameFolder" Content="Save all files in the same folder location" Style="{StaticResource DarkRadio}" GroupName="ExportRules" IsChecked="True" Margin="0,0,24,0"/>
                                <RadioButton x:Name="RbSplitByFormat" Content="Save and split files by file format" Style="{StaticResource DarkRadio}" GroupName="ExportRules"/>
                            </StackPanel>
                        </Grid>

                        <!-- Export Queue Grid -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="EXPORT QUEUE" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                            
                            <Border Grid.Row="1" CornerRadius="8" BorderBrush="{DynamicResource GridBorder}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Border x:Name="MaskDark" Background="White" CornerRadius="8"/>
                                    <DataGrid x:Name="GridQueue" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" BorderThickness="0">
                                        <DataGrid.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=MaskDark}"/>
                                        </DataGrid.OpacityMask>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="View/Sheet Number" Binding="{Binding SheetNumber}" Width="150" IsReadOnly="True" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="View/Sheet Name" Binding="{Binding SheetName}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="80" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Custom File Name" Binding="{Binding TargetFileName}" Width="2.5*" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Status" Width="100" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="StatusBorder" Padding="4,2" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Done">
                                                            <Setter TargetName="StatusBorder" Property="Background" Value="#5CB85C"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#111111"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Exporting...">
                                                            <Setter TargetName="StatusBorder" Property="Background" Value="#FFB300"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#111111"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter TargetName="StatusBorder" Property="Background" Value="#E53935"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Progress reporting section -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- ProgressBar styled custom dark-red -->
                            <ProgressBar x:Name="ExportProgressBar" Grid.Column="0" Height="20" Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                                         Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#5CB85C">
                            </ProgressBar>
                            <TextBlock x:Name="TxtPercent" Grid.Column="1" Text="Completed 0%" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- STATUS / NAVIGATION BAR -->
            <Border x:Name="FooterBorder" Grid.Row="3" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,12" CornerRadius="0,0,11,11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Selection Status stats text -->
                    <TextBlock x:Name="StatusTextBlock" Grid.Row="0" Text="0 sheets and 0 views selected. Total: 0" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,6"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Feedback Buttons -->
                            <ColumnDefinition Width="*"/>    <!-- Spacer -->
                            <ColumnDefinition Width="Auto"/> <!-- Status Text & Settings -->
                            <ColumnDefinition Width="Auto"/> <!-- Nav Buttons -->
                        </Grid.ColumnDefinitions>
                        
                        <!-- Feedback Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        </StackPanel>
                        
                        <!-- Scheduling assistant & reset Settings -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            
                            <Button x:Name="BtnResetSettings" Content="?" FontSize="16" Background="Transparent" Foreground="{DynamicResource CustomFileNameHeaderFg}" 
                                    BorderThickness="0" Width="28" Height="28" Cursor="Hand" Click="BtnResetSettings_Click" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CustomFileNameHeaderBorder}" BorderThickness="1" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Back & Next Navigation Buttons -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Button x:Name="BtnBack" Content="Back" Style="{StaticResource SecondaryBtn}" Width="80" Height="32" Margin="0,0,10,0" Click="BtnBack_Click"/>
                            <Button x:Name="BtnNext" Content="Next" Style="{StaticResource PrimaryBtn}" Width="80" Height="32" Click="BtnNext_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Resizing Grip -->
            <ResizeGrip Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Width="14" Height="14" Cursor="SizeNWSE" Opacity="0.5"/>
        </Grid>
    </Border>
</Window>

