<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="180" Width="380"
        WindowStartupLocation="CenterScreen" Background="#0b0b0b" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Rectangle Grid.Row="0" Height="2" Fill="#7b2222" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
        
        <TextBlock x:Name="MessageText" Grid.Row="1" Text="Message" 
                   Foreground="#e0e0e0" FontSize="14" FontFamily="Segoe UI" 
                   TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                   
        <Button x:Name="OkButton" Grid.Row="2" Content="OK" Height="30" Width="90" 
                Background="#7b2222" Foreground="White" BorderThickness="0" 
                FontWeight="Bold" HorizontalAlignment="Center" Click="ok_clicked" Margin="0,15,0,0"/>
    </Grid>
</Window>
